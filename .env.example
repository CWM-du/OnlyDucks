# Copy to .env.local and fill in local values. Never commit real secrets.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://onlyducks:onlyducks_local@localhost:5432/onlyducks?schema=public

# Oscar API integration — fill in only when access details are confirmed
OSCAR_API_BASE_URL=
OSCAR_API_KEY=

# Identity provider — names are proposed placeholders, adapt to provider
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_CALLBACK_URL=http://localhost:3000/api/auth/callback

# Optional object storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
