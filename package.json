{
  "name": "onlyducks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "auth:create-demo-user": "node scripts/create-demo-user.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.0",
    "prettier": "^3.6.0",
    "prisma": "^6.19.0",
    "typescript": "^5.9.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "postcss": "8.5.32",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  }
}
