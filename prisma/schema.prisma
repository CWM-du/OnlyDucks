generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MentorSessionStatus {
  ACTIVE
  COMPLETED
  FAILED
  CANCELLED
}

enum ContentType {
  ARTICLE
  JOB
  PRODUCT
}

model User {
  id             String          @id @default(cuid())
  externalUserId String          @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  mentorSessions MentorSession[]
}

model MentorProfile {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  technology  String
  teachingStyle String
  promptKey   String
  isEnabled   Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  sessions    MentorSession[]
}

model MentorSession {
  id              String              @id @default(cuid())
  userId          String
  mentorId        String
  status          MentorSessionStatus @default(ACTIVE)
  startedAt       DateTime            @default(now())
  endedAt         DateTime?
  lastActivityAt  DateTime            @default(now())
  turnCount       Int                 @default(0)
  promptKeyUsed   String
  recommendationType       String?
  recommendationTopic      String?
  recommendationReason     String?
  recommendationInvitation String?
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentor   MentorProfile @relation(fields: [mentorId], references: [id])
  messages MentorMessage[]
  usage    OscarUsage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([mentorId, startedAt])
  @@index([status, lastActivityAt])
}

model ContentItem {
  id            String      @id @default(cuid())
  externalId    String?
  type          ContentType
  title         String
  summary       String?
  destinationUrl String
  source        String
  publishedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([source, externalId])
  @@index([type, publishedAt])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventType   String
  userId      String?
  sessionId   String?
  contentId   String?
  destination  String?
  properties  Json?
  occurredAt  DateTime @default(now())

  @@index([eventType, occurredAt])
  @@index([sessionId])
}
enum MentorMessageRole {
  USER
  ASSISTANT
}

model MentorPrompt {
  id        String   @id @default(cuid())
  key       String   @unique
  content   String   @db.Text
  createdAt DateTime @default(now())
}

model MentorMessage {
  id         String            @id @default(cuid())
  sessionId  String
  role       MentorMessageRole
  content    String            @db.Text
  turnNumber Int
  tokensIn   Int?
  tokensOut  Int?
  createdAt  DateTime          @default(now())
  session    MentorSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model OscarUsage {
  id                String   @id @default(cuid())
  userId            String
  sessionId         String
  messageId         String?
  model             String
  tokensIn          Int
  tokensOut         Int
  costEstimateCents Int
  createdAt         DateTime @default(now())
  session           MentorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sessionId])
}
