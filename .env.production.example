# Copy to .env.production on the VPS. Never commit the populated file.
DOMAIN=app.example.com
ACME_EMAIL=ops@example.com
APP_BASE_URL=https://app.example.com

# Use a long randomly generated hexadecimal password to avoid URL encoding issues.
POSTGRES_USER=onlyducks
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET
POSTGRES_DB=onlyducks

# Pin IMAGE_TAG to an immutable release tag or digest in real deployments.
IMAGE_TAG=release-placeholder

# Configure only after the corresponding integrations are implemented and approved.
OSCAR_API_BASE_URL=
OSCAR_API_KEY=
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_CALLBACK_URL=https://app.example.com/api/auth/callback
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
